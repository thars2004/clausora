# Clausora Environment Variables Configuration
# Copy this file to .env or configure in Render / Vercel dashboard

# Runtime Environment
NODE_ENV=development
PORT=5000
APP_BASE_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Database (MongoDB Atlas)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/clausora?retryWrites=true&w=majority
# Note: Clausora includes an automatic in-memory fallback for local zero-config offline runs if MONGODB_URI is blank!
MONGODB_URI=

# Authentication & Security
JWT_SECRET=clausora_super_secure_jwt_secret_change_in_production_2026_xyz
COOKIE_SECRET=clausora_cookie_session_secret_change_me_999888

# Google Gemini AI Provider (Recommended for Clausora AI Agent)
# Get free key from: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Hugging Face AI Provider (Multimodal Vision-Language Model)
# Recommended model: Qwen/Qwen2.5-VL-7B-Instruct
# Get free token from: https://huggingface.co/settings/tokens
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-VL-7B-Instruct

# PayPal Developer Sandbox (Orders v2)
# Get credentials from: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=

# Email / Notifications (Optional)
EMAIL_PROVIDER=console
EMAIL_FROM=Clausora <notifications@clausora.dev>
EMAIL_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Demo / Judge Auto-Seed Mode
ENABLE_DEMO_SEED=true

